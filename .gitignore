# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/
*.whl

# Environment files — never committed.
# `.env.example` (committed templates) is whitelisted below so new
# contributors see what variables each service expects. Anything
# matching the patterns above it is ignored at any directory depth.
.env
.env.local
.env.*.local
*.env
!.env.example
!**/.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
.cursor/
.claude/
.serena/
# codanna code-intelligence MCP server. The index lives OUTSIDE the repo
# (~/.codanna), and .codanna/settings.toml holds machine-specific absolute paths
# + a project-id, so the whole dir is per-developer. Portable bits are committed:
# .mcp.json (server registration) and .codannaignore. The trailing slash ignores
# only the DIRECTORY — the .codannaignore file stays tracked.
.codanna/
# Claude Code skill plugins installed locally. Skills already committed
# (design-taste-frontend, full-output-enforcement, high-end-visual-design,
# redesign-existing-projects) stay tracked — gitignore only applies to
# untracked paths, so locking the directory doesn't un-stage anything.
.agents/

# Testing
.pytest_cache/
.ruff_cache/
.benchmarks/
.coverage
htmlcov/
coverage/

# Docker
.docker/

# Documentation
# Block scratch markdown at the repo ROOT only (e.g., prompt dumps, snapshot
# pastes from manual MCP runs). Subdirectory README.md / *.md files are
# tracked normally so feature-folder docs stay in version control.
/*.md
!/README.md
!/CLAUDE.md
!/REFACTOR_PROGRESS.md
!/CODE_HEALTH.md
!/CONTRIBUTING.md
!/FRONTEND_PROGRESS.md
!/CLOUD_PROGRESS.md
!/SECURITY.md
!/SEC_PROGRESS.md

# Old app folders (legacy)
apps/

# Design-system prototype (source spec for the frontend revamp — extracted into
# .agents/skills/shuttleworks-design/; kept on disk as visual reference, not tracked).
/ShuttleWorks Prototype/
# claude.ai/design source-of-truth export — mirrors the tracked skill
# (.agents/skills/shuttleworks-design/); a local reference for offline agents,
# not a second copy to version.
/ShuttleWorks Design System-handoff/
# claude.ai/design mockup exports at repo root (design references pointed to by
# specs; they need bound _ds/ assets to render, so keep them as local reference,
# not tracked — same treatment as the prototype folders above).
/ShuttleWorks - *.dc.html

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# JS build output (per-app + root workspace)
#
# These were `**/frontend/...` globs until SP-REORG-1. That pattern keyed on a
# DIRECTORY NAME, so renaming products/scheduler/frontend to apps/console would
# have silently un-ignored node_modules, dist and the tsbuildinfo under the new
# name - thousands of untracked files, and nothing to announce it but a longer
# `git status`. Keyed on the apps/ tier instead, so a future app is covered the
# day it is created and a rename cannot outrun it.
/node_modules/
apps/*/node_modules/
apps/*/dist/
apps/*/build/
apps/*/.vite/
apps/*/tsconfig.tsbuildinfo
tests/e2e/node_modules/
packages/*/node_modules/
packages/*/dist/

# Persisted state (Docker volumes; runtime, not source)
**/data/

# Local SQLite databases (dev + tests)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# E2E tests (per-product)
**/e2e/node_modules/
**/e2e/playwright-report/
**/e2e/test-results/
**/e2e/blob-report/
**/e2e/.playwright/
**/e2e/shots/

# Playwright MCP scratch dir — screenshots, page snapshots, console logs,
# and any downloaded artifacts from browser_navigate / browser_take_screenshot.
.playwright-mcp/

# Loose debug artifacts dropped at the repo root during manual MCP testing.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webm
/schedule_*.csv
/schedule_*.xlsx
/roster_*.csv
/roster_*.xlsx
/matches_*.csv
/matches_*.xlsx

# UI-iteration screenshots — kept locally as visual references but not
# version-controlled; they age out quickly with frontend changes.
**/docs/screenshots/

# Playwright baseline screenshot output — regenerated by the e2e
# `99-baseline-screenshots.spec.ts` run on every CI build, so the
# PNGs themselves don't belong in version control. Already in the
# root .dockerignore; mirror it here.
design/baseline/

# Superpowers SDD scratch (ledger, briefs, reports, review packages, brainstorm artifacts)
.superpowers/

# VitePress docs site — build output + dependency cache (regenerated by docs:build).
# Un-anchored so a stray root .vitepress/cache (from running vitepress without the
# docs arg) is ignored too.
.vitepress/dist/
.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Self-host secrets + Postgres bind mount (docker-compose.selfhost.yml).
secrets/
data/postgres/
