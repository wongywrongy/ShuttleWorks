# ShuttleWorks — repo-root environment template.
#
# This file is committed; the real `.env` (and `.env.local`) files are
# gitignored. **Never commit real values to this repo.**
#
# This file covers ONLY what you need to run the app locally from a
# checkout. It is deliberately not a full reference: it used to claim to
# list "every variable the cloud deployment needs" and did not — it was
# missing every variable the cloud startup validator actually enforces,
# so an operator who followed it got a backend that raised on boot.
# Two copies of the same list drift; there is now one canonical copy per
# concern:
#
#   products/scheduler/backend/.env.example    every backend variable,
#                                              documented per variable
#   products/scheduler/frontend/.env.example   frontend build/dev vars
#   products/scheduler/.env.example            compose ports/project name
#   products/scheduler/.env.selfhost.example   the self-hosted stack
#   products/scheduler/.env.worker.example     a remote worker host
#
# Deploying? Start at docs/how-to/install-selfhost.md (cloud) or
# docs/how-to/install-local.md (single machine), not here.

# ===== Backend (products/scheduler/backend) =========================

# SQLAlchemy URL. SQLite for local dev; Postgres for cloud.
# Cloud form: postgresql://scheduler:[PASSWORD]@[HOST]:5432/scheduler
DATABASE_URL=sqlite:///./local.db

# Deployment metadata. `local` is the zero-config solo mode: no signup,
# no email, no network. `cloud` turns on a fail-closed startup validator
# that requires a non-sqlite DATABASE_URL, AUTH_MODE=cloud,
# SESSION_COOKIE_SECURE=true, real SMTP, and OPS_TOKEN — see
# backend/.env.example for all of them.
ENVIRONMENT=local
LOG_LEVEL=info

# Network + CORS. JSON-list or CSV both work.
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Writable runtime data directory (the readiness probe checks this).
DATA_DIR=./data

# ===== Frontend (products/scheduler/frontend) =======================

# Backend API base. Vite proxies /api/* in dev; a deployed frontend
# serves the API on its own origin through nginx, so /api stays correct.
VITE_API_BASE_URL=/api
