{
  "name": "cp-sat-scheduling-engine",
  "private": true,
  "version": "0.0.0",
  "description": "Scheduler product (meet + bracket draws) + shared design-system. The legacy two-product layout was unified in the backend-merge arc (PRs 1-3).",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/console",
    "apps/entrant"
  ],
  "overrides": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3"
  },
  "scripts": {
    "dev:scheduler": "npm run -w apps/console dev --",
    "dev:entrant": "npm run -w apps/entrant dev --",
    "build:scheduler": "npm run -w apps/console build",
    "build:entrant": "npm run -w apps/entrant build",
    "build:all": "npm run build:scheduler && npm run build:entrant",
    "lint:scheduler": "npm run -w apps/console lint",
    "lint:entrant": "npm run -w apps/entrant lint",
    "test:contrast": "node packages/design-system/scripts/check-contrast.mjs",
    "test:classes": "node packages/design-system/scripts/check-classes.mjs",
    "figma:tokens": "node tools/export-figma-tokens.mjs",
    "figma:tokens:check": "node tools/export-figma-tokens.mjs --check",
    "typecheck:entrant": "npm run -w apps/entrant typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:docs": "node --test tools/tests/*.test.mjs",
    "docs:paths": "node tools/docs-paths.mjs",
    "docs:freshness": "node tools/docs-freshness.mjs",
    "depcruise": "npm --prefix apps/console run depcruise",
    "depcruise:entrant": "npm --prefix apps/entrant run depcruise",
    "jscpd": "jscpd",
    "knip": "npm --prefix apps/console run knip",
    "knip:entrant": "npm --prefix apps/entrant run knip",
    "test:scheduler": "npm --prefix apps/console run test:run",
    "test:entrant": "npm --prefix apps/entrant run test:run",
    "test:entrant:unit": "npm --prefix apps/entrant run test:unit",
    "test:entrant:ssr": "npm --prefix apps/entrant run test:ssr",
    "test:cov": "npm --prefix apps/console run test:cov"
  },
  "devDependencies": {
    "jscpd": "^5.0.11",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.6"
  }
}
