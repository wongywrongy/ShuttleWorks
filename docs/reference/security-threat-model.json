{
  "schemaVersion": 1,
  "reviewCadence": "before each release candidate and after any trust-boundary change",
  "severityPolicy": "critical/high risks block production unless closed or explicitly accepted by the named owner",
  "surfaces": [
    "cloud-control-plane",
    "event-node",
    "sync-protocol",
    "venue-lan",
    "backups",
    "installer-update-channel",
    "operator-device"
  ],
  "threats": [
    {
      "id": "TM-001",
      "surface": "cloud-control-plane",
      "stride": ["spoofing", "elevation-of-privilege", "information-disclosure"],
      "scenario": "A principal crosses an organization or workspace boundary by guessing an identifier.",
      "severity": "critical",
      "controls": ["membership-scoped repositories", "cross-tenant 404 policy", "CSRF-protected session cookies"],
      "verification": ["tests/backend/test_tenant_isolation.py", "tests/backend/test_auth_surface.py"],
      "owner": "identity-module-owner",
      "status": "mitigated"
    },
    {
      "id": "TM-002",
      "surface": "event-node",
      "stride": ["spoofing", "tampering", "denial-of-service"],
      "scenario": "A LAN client becomes an operator, changes live state, or exhausts the node during a WAN outage.",
      "severity": "critical",
      "controls": ["event-scoped offline sessions", "anonymous bootstrap disabled", "authority epoch fencing", "SQLite WAL and bounded busy timeout"],
      "verification": ["tests/backend/unit/test_offline_operator_sessions.py", "tests/backend/unit/test_event_node_acceptance.py"],
      "owner": "event-operations",
      "status": "partially-mitigated",
      "residualRisk": "OS credential custody, venue load, and abrupt-power-loss behavior require reference-hardware rehearsal."
    },
    {
      "id": "TM-003",
      "surface": "sync-protocol",
      "stride": ["spoofing", "tampering", "repudiation"],
      "scenario": "A stale or competing node uploads forged, reordered, duplicated, or incompatible operations.",
      "severity": "critical",
      "controls": ["signed device identity", "capability digest", "epoch and sequence checks", "idempotent operation IDs", "quarantine"],
      "verification": ["tests/backend/unit/test_sync_protocol.py", "tests/backend/unit/test_authority_lifecycle.py", "tests/backend/unit/test_event_node_identity.py"],
      "owner": "sync-module-owner",
      "status": "mitigated"
    },
    {
      "id": "TM-004",
      "surface": "venue-lan",
      "stride": ["spoofing", "information-disclosure", "denial-of-service"],
      "scenario": "An untrusted venue client intercepts credentials or reaches a clear-text/operator service directly.",
      "severity": "high",
      "controls": ["stable TLS origins", "Secure HttpOnly cookies", "loopback-only clear-text ports", "explicit LAN bind"],
      "verification": ["tests/backend/unit/test_lan_tls_config.py", "tools/lan-tls-preflight.sh"],
      "owner": "platform-oncall",
      "status": "partially-mitigated",
      "residualRisk": "Client CA distribution, firewall rules, certificate renewal, and hostile-LAN rehearsal are deployment responsibilities."
    },
    {
      "id": "TM-005",
      "surface": "backups",
      "stride": ["tampering", "information-disclosure", "denial-of-service"],
      "scenario": "A stolen, corrupt, stale, or path-confused backup exposes data or prevents recovery.",
      "severity": "high",
      "controls": ["authenticated encryption", "checksums", "safe destinations", "isolated restore preflight", "two-generation retention"],
      "verification": ["tests/backend/unit/test_recovery_bundle.py", "tests/backend/unit/test_backup_scheduler.py"],
      "owner": "platform-oncall",
      "status": "partially-mitigated",
      "residualRisk": "Production key custody, offsite provisioning, and timed clean-machine restores remain operational gates."
    },
    {
      "id": "TM-006",
      "surface": "installer-update-channel",
      "stride": ["tampering", "elevation-of-privilege", "denial-of-service"],
      "scenario": "A malicious or incompatible release is installed, or rollback loses live-event state.",
      "severity": "critical",
      "controls": ["SBOM and provenance", "keyless image signing", "pinned CI actions", "signed update/rollback metadata", "schema compatibility checks", "pre-upgrade verified backup"],
      "verification": [".github/workflows/security.yml", ".github/workflows/publish-release.yml", "tools/tests/release-workflow.test.mjs", "tests/backend/unit/test_event_node_update.py"],
      "owner": "release-owner",
      "status": "partially-mitigated",
      "residualRisk": "Desktop signing, notarization, staged updater, and offline rollback rehearsal are not implemented."
    },
    {
      "id": "TM-007",
      "surface": "operator-device",
      "stride": ["spoofing", "repudiation", "information-disclosure"],
      "scenario": "A lost browser or laptop retains authority credentials or leaks participant data through logs and telemetry.",
      "severity": "high",
      "controls": ["revocable enrolled devices", "bounded offline sessions", "authority closure invalidation", "telemetry allowlist and cardinality policy"],
      "verification": ["tests/backend/unit/test_event_node_identity.py", "tests/backend/unit/test_operational_telemetry.py"],
      "owner": "event-operations",
      "status": "partially-mitigated",
      "residualRisk": "Device encryption, screen lock, browser hardening, and lost-device response require operator policy and training."
    },
    {
      "id": "TM-008",
      "surface": "cloud-control-plane",
      "stride": ["information-disclosure", "denial-of-service"],
      "scenario": "Public display or entrant endpoints are enumerated, flooded, or used to disclose a different tenant's event data.",
      "severity": "high",
      "controls": ["separate public principals", "workspace-scoped lookup", "payload bounds", "credential and request throttles"],
      "verification": ["tests/backend/test_auth_surface.py", "tests/backend/test_abuse_limits.py", "tests/backend/test_entries_submit_api.py"],
      "owner": "identity-module-owner",
      "status": "mitigated"
    },
    {
      "id": "TM-009",
      "surface": "event-node",
      "stride": ["information-disclosure", "repudiation"],
      "scenario": "PII or credentials leak through logs, traces, metrics, exports, recovery artifacts, or future support bundles.",
      "severity": "high",
      "controls": ["telemetry attribute allowlist", "bounded resource attributes", "encrypted backups", "no operation payloads in alerts"],
      "verification": ["tests/backend/unit/test_operational_telemetry.py", "tests/backend/unit/test_telemetry_event_node.py", "tests/backend/unit/test_recovery_bundle.py"],
      "owner": "platform-oncall",
      "status": "partially-mitigated",
      "residualRisk": "A redacted support-bundle format and production access/retention policy are not yet implemented."
    },
    {
      "id": "TM-010",
      "surface": "event-node",
      "stride": ["denial-of-service"],
      "scenario": "Large payloads, adversarial solver inputs, telemetry growth, or disk exhaustion prevent tournament commands.",
      "severity": "critical",
      "controls": ["request size limits", "solver job limits and leases", "persistent telemetry queue limits", "disk/WAL health signals", "fail-open telemetry"],
      "verification": ["tests/backend/test_abuse_limits.py", "tests/backend/unit/test_reliability_failure_paths.py", "tests/backend/unit/test_telemetry_event_node.py"],
      "owner": "event-operations",
      "status": "partially-mitigated",
      "residualRisk": "Two-times-scale hostile load and disk-full behavior require supported-hardware tests."
    }
  ]
}
