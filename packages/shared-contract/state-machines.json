      "state_keys": {
        "confirmed": "confirmed",
        "pending": "pending",
        "rejected": "rejected",
        "unverified": "unverified",
        "waitlisted": "waitlisted",
        "withdrawn": "withdrawn"
      },
      "event_keys": {
        "confirm": "confirm",
        "operator_withdraw": "operator_withdraw",
        "promote": "promote",
        "reject": "reject",
        "verify": "verify",
        "waitlist_at_cap": "waitlist_at_cap",
        "withdraw": "withdraw"
      }
