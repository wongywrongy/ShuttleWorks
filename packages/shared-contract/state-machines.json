{
  "machines": {
    "authority_epoch": {
      "name": "authority_epoch",
      "version": 1,
      "states": [
        "active",
        "closed",
        "cloud",
        "preparing",
        "recovered"
      ],
      "initial": [
        "active",
        "cloud",
        "preparing"
      ],
      "terminal": [
        "closed",
        "recovered"
      ],
      "transitions": [
        {
          "event": "ready",
          "from_states": [
            "preparing"
          ],
          "to": "active",
          "actor": "operator",
          "guard": null,
          "consequential": true,
          "description": "The node presented its readiness proof."
        },
        {
          "event": "close",
          "from_states": [
            "active"
          ],
          "to": "closed",
          "actor": "operator",
          "guard": null,
          "consequential": true,
          "description": "Check-in or handoff drained the operation log."
        },
        {
          "event": "recover",
          "from_states": [
            "active",
            "preparing"
          ],
          "to": "recovered",
          "actor": "operator",
          "guard": null,
          "consequential": true,
          "description": "Lost-node recovery rebuilt from a backup plus the receipted operation suffix."
        }
      ],
      "state_attribute": "state",
      "state_keys": {
        "active": "active",
        "closed": "closed",
        "cloud": "cloud",
        "preparing": "preparing",
        "recovered": "recovered"
      },
      "event_keys": {
        "close": "close",
        "ready": "ready",
        "recover": "recover"
      }
    },
    "competition_event": {
      "name": "competition_event",
      "version": 1,
      "states": [
        "completed",
        "in_progress",
        "scheduled"
      ],
      "initial": [
        "scheduled"
      ],
      "terminal": [
        "completed"
      ],
      "transitions": [
        {
          "event": "start",
          "from_states": [
            "scheduled"
          ],
          "to": "in_progress",
          "actor": "operator",
          "guard": null,
          "consequential": true,
          "description": "S-8.5: the director starts the event explicitly, before any result."
        },
        {
          "event": "first_result",
          "from_states": [
            "scheduled"
          ],
          "to": "in_progress",
          "actor": "system",
          "guard": null,
          "consequential": true,
          "description": "S-8.5: the first recorded result starts the event. Today the draw reaching `started` is that signal."
        },
        {
          "event": "complete",
          "from_states": [
            "in_progress",
            "scheduled"
          ],
          "to": "completed",
          "actor": "system",
          "guard": null,
          "consequential": true,
          "description": "The event's draw reached `completed`."
        }
      ],
      "state_attribute": "status",
      "state_keys": {
        "completed": "completed",
        "in_progress": "in_progress",
        "scheduled": "scheduled"
      },
      "event_keys": {
        "complete": "complete",
        "first_result": "first_result",
        "start": "start"
      }
    },
