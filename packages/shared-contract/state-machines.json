          "consequential": true,
          "description": ""
        },
        {
          "event": "promote",
          "from_states": [
            "waitlisted"
          ],
          "to": "pending",
          "actor": "operator",
          "guard": null,
          "consequential": true,
          "description": ""
        },
        {
          "event": "withdraw",
          "from_states": [
            "confirmed",
            "pending",
            "unverified",
            "waitlisted"
          ],
          "to": "withdrawn",
          "actor": "entrant",
          "guard": "before_withdrawal_deadline",
          "consequential": true,
          "description": ""
        },
        {
          "event": "operator_withdraw",
          "from_states": [
            "confirmed",
            "pending",
            "unverified",
            "waitlisted"
          ],
          "to": "withdrawn",
          "actor": "operator",
          "guard": null,
          "consequential": true,
          "description": ""
        }
      ],
