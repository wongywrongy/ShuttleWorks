          "description": ""
        },
        {
          "event": "confirm",
          "from_states": [
            "pending"
          ],
          "to": "confirmed",
          "actor": "operator",
          "guard": "is_pending_exactly",
          "consequential": true,
          "description": ""
        },
        {
          "event": "reject",
          "from_states": [
            "pending",
            "unverified",
            "waitlisted"
