# Tournament Scheduler Environment Configuration
# Copy this to .env and customize as needed

# === Compose project layout ===
# Project name namespaces containers, networks, and volumes so the
# tournament prototype (`tournament`) can run alongside this stack on
# the same Docker daemon. Host ports likewise differ across the two
# stacks; keep these defaults unless you intend to remap.
COMPOSE_PROJECT_NAME=btp
FRONTEND_HOST_PORT=80
BACKEND_HOST_PORT=8000

# === Backend ===
LOG_LEVEL=info

# === Frontend (build-time) ===
# API URL for frontend to call backend
# For Docker: /api (nginx proxies to backend)
# For development: http://localhost:8000
VITE_API_BASE_URL=/api

# === Other stacks ===
# This file configures the DEFAULT stack (docker-compose.yml) only.
# The deployment stacks have their own templates, because each fails
# fast on variables that mean nothing to the others:
#
#   .env.selfhost.example  → docker-compose.selfhost.yml
#   .env.worker.example    → docker-compose.worker.yml
#
# Full per-variable backend docs: backend/.env.example.
#
# (A "Future Cloud Deployment" block used to sit here listing
# DATABASE_URL, REDIS_URL and SECRET_KEY. Cloud shipped; there is no
# Redis in this product and no SECRET_KEY in app/config.py — neither
# name was ever read by anything.)
