# ShuttleWorks frontend — environment template.
#
# Vite exposes only variables prefixed ``VITE_`` to the client bundle.
# Copy to `.env.local` (or `.env`) and fill in the values.
#

# API base. Vite proxies /api/* in dev, and a deployed frontend serves
# the API on its own origin through nginx — so /api is correct in both.
# Only set an absolute URL if the frontend is genuinely hosted on a
# different origin from the API.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy sends /api/* (dev only). Defaults to :8000.
#
# Set this when running the backend on the host instead of in Docker.
# Port 8000 is in a Windows reserved range, so a host backend usually
# listens on 8600 — and :8000 is also exactly where the Docker backend
# listens. Leave this unset with the stack still up and every browser
# call silently hits the CONTAINER, not your host process: backend edits
# appear to do nothing. Check `docker ps` first.
# VITE_API_PROXY_TARGET=http://localhost:8600

# Set to 1 to mount the interaction error harness, which surfaces
# runtime errors that a green unit suite can hide (a button that throws
# on click still passes every test that never clicks it). Used by the
# interaction-smoke CI job; useful locally when auditing UI by hand.
# VITE_ERROR_HARNESS=1

# (PR 3 of the backend-merge arc removed ``VITE_TOURNAMENT_APP_URL``.
# The bracket UI moved inside the scheduler shell at the ``Bracket``
# tab so the dashboard no longer opens a separate stack in a new
# tab. If you're upgrading and the variable is still in your
# ``.env.local``, you can delete it — it's a no-op.)
