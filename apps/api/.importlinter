; Backend architecture contracts (SP-REORG-1 Phase 2).
;
; WHY THIS EXISTS, AND WHY IT IS WRITTEN BEFORE ANY BACKEND FILE MOVES.
;
; The console has had a machine-checked module contract for months
; (apps/console/src/platform/contracts/moduleContract.ts and its test). The API
; has had the same seams, enforced by nothing but review. Phase 3 repackages
; this tree into domain packages; if the seam map were written AFTER that move
; it would encode whatever the move happened to produce. Written first, it
; encodes what is true now, and the move becomes a change the machine can
; check rather than a change we hope is faithful.
;
; Run with `lint-imports` from apps/api, or `make check` from the repo root.
;
; The layout is still flat - `api`, `services`, `database`, `repositories` and
; `adapters` are top-level packages on sys.path - so domain membership is
; enumerated module by module below. Phase 3 replaces every one of these lists
; with a single package name.
;
; ---------------------------------------------------------------------------
; DIRECT vs INDIRECT
;
; The domain contracts set `allow_indirect_imports`, so they judge only edges a
; module declares itself. That is deliberate. Everything in this tree reaches
; `database`, `repositories` and `app` - that is what a shared kernel is for -
; so every domain is transitively connected to every other through it, and a
; transitive contract would report that as coupling between domains. It is not.
; What a module boundary means is: this domain does not name that one.
;
; The layers, kernel and engine-purity contracts DO judge transitively, because
; for those three the whole question is what a module drags in behind it.
; ---------------------------------------------------------------------------
;
; ---------------------------------------------------------------------------
; THE TWO ROOT LEAKS
;
; Both are function-local imports. Deferring an import hides a cycle from
; Python's import machinery, not from the architecture, so import-linter is
; right to count them and this file will not pretend otherwise. Both sit at the
; bottom of the tree, so anything that touches a repository or reads settings
; inherits them - which is why two edges broke eight contracts on the first run.
;
;   L1  app.form_csrf -> services.auth              (app/form_csrf.py:161)
;       The kernel's CSRF check resolves an operator session to decide whether
;       a cookie proves anything, opening its own SessionLocal to do it. Either
;       the check belongs above the kernel or `resolve_session` belongs below.
;
;   L2  repositories.local -> services.match_state  (repositories/local.py:1886)
;       The repository applies a state transition inside the command
;       transaction. The transaction boundary is genuinely at the repository and
;       the transition table is genuinely in the service, so this one is not
;       fixed by moving an import.
;
; Both are recorded in docs/audits/debt-log.md. SP-REORG-1 does not fix them: it
; is a behaviour-preserving program and either fix moves real logic.
; ---------------------------------------------------------------------------

[importlinter]
root_packages =
    api
    app
    services
    database
    repositories
    adapters
    scheduler_core
include_external_packages = False


; ---------------------------------------------------------------------------
; 1. LAYERS - the HTTP surface sits above the services, which sit above
;    persistence. `app` is deliberately absent from this stack: it is both the
;    shared kernel (config, schemas, exceptions, error codes) that every layer
;    reads AND the composition root (`app.main` wires the routers together), so
;    it has no single position in a linear order. Contract 2 constrains it
;    instead.
; ---------------------------------------------------------------------------
[importlinter:contract:layers]
name = HTTP above services above persistence
type = layers
layers =
    api
    services
    repositories
    database
ignore_imports =
    ; DEBT(REORG-1) L1 - see the header.
    app.form_csrf -> services.auth
    ; DEBT(REORG-1) L2 - see the header.
    repositories.local -> services.match_state
    ; DEBT(REORG-1): the solve child re-enters the HTTP layer to reuse the meet
    ; engine entry point. `api.schedule` holds both the FastAPI router and the
    ; problem-building call the child needs; the child wants the second and is
    ; made to import the first. Splitting the engine entry out of the router is
    ; Phase 3 work, not a path update.
    services.solve_child -> api.schedule


; ---------------------------------------------------------------------------
; 2. The kernel does not depend on the surfaces it serves. `app.main` and
;    `app.dependencies` are absent from the source list by construction: a
;    composition root exists to import everything, and the second is the
;    FastAPI DI wiring. Everything else under `app/` must stay beneath.
; ---------------------------------------------------------------------------
[importlinter:contract:kernel-direction]
name = The shared kernel does not import the surfaces
type = forbidden
source_modules =
    app.config
    app.schemas
    app.exceptions
    app.error_codes
    app.constants
    app.limits
    app.paths
    app.time_utils
    app.body_limit
    app.client_ip
forbidden_modules =
    api
    services
    repositories
ignore_imports =
    ; DEBT(REORG-1) L1 - see the header. This contract is the one that would
    ; catch L1 on its own merits, so the ignore is the debt, not a workaround.
    app.form_csrf -> services.auth


; ---------------------------------------------------------------------------
; 3. ENGINE PURITY - scheduler_core is a pure CP-SAT library: dataclasses in,
;    dataclasses out (ADR 0004, ADR 0006). If it ever imports the application it
;    stops being installable on its own and `examples/` stops being honest about
;    what the engine needs. Judged transitively, and with no allowances.
; ---------------------------------------------------------------------------
[importlinter:contract:engine-purity]
name = The engine knows nothing about the application
type = forbidden
source_modules =
    scheduler_core
forbidden_modules =
    api
    app
    services
    database
    repositories
    adapters


; ---------------------------------------------------------------------------
; 4. THE PINNED ABSENCE - Operations must not reach into Bracket.
;
;    This is the backend twin of the console's contract test, which pins the
;    Operations -> Bracket *advancement* seam as deliberately UNWIRED: bracket
;    results travel the idempotent command path (POST /bracket/commands), not a
;    direct call from the operations surface. The edge is absent today. This
;    contract is what stops "absent" becoming "absent so far".
;
;    Judged transitively and with no allowances, because an indirect path would
;    be just as much a wiring of the seam. See ADR 0007 and moduleContract.ts.
; ---------------------------------------------------------------------------
[importlinter:contract:operations-not-bracket]
name = Operations does not reach into Bracket (the unwired advancement seam)
type = forbidden
source_modules =
    api.match_state
    api.commands
    services.match_state
    services.conflict_metrics
forbidden_modules =
    api.brackets
    services.bracket


; ---------------------------------------------------------------------------
; 5. DOMAIN INDEPENDENCE - one contract per domain, each forbidding the domains
;    that domain does not name today. Every edge that DOES exist is listed in
;    the comment above its contract with the seam it serves. A new edge is
;    either absent from a forbidden list (and therefore already documented
;    above it) or the gate reports it.
;
;    FOUR MODULES ARE DELIBERATELY UNFILED, because three or more domains
;    import them and filing them under one would make every other consumer
;    violate a boundary that is not really there:
;
;      adapters.badminton      sport adapter    - meet, bracket, solve_rail
;      services.scheduling.*   the ScheduleConfig seam - meet, bracket
;      services.email          notification transport  - identity, workspaces
;      services.turnstile      bot check               - identity
;      services.auth (throttle) abuse throttle          - identity, entries
;
;    They are shared infrastructure. The program's Phase 3 target files all four
;    under a single domain; the import graph contradicts that, and the Phase 2
;    gate asks for a ruling.
; ---------------------------------------------------------------------------

; Operations names nothing outside itself. It is the most self-contained
; domain in the tree, and the only one with no outgoing edge at all.
[importlinter:contract:operations-independence]
name = Operations names no other domain
type = forbidden
allow_indirect_imports = True
source_modules =
    api.match_state
    api.commands
    services.match_state
    services.conflict_metrics
forbidden_modules =
    api.schedule
    api.schedule_proposals
    api.schedule_director
    api.display
    api.entries
    api.entries_json
    api.entries_site
    api.auth
    api.invites
    api.entrants
    api.tournaments
    services.meet
    services.entries
    services.auth
    services.solve_jobs

; Bracket names only the shared scheduling seam (services.scheduling.params,
; unfiled infrastructure - see above). No other domain.
[importlinter:contract:bracket-independence]
name = Bracket names no other domain
type = forbidden
allow_indirect_imports = True
source_modules =
    api.brackets
    services.bracket
forbidden_modules =
    api.match_state
    api.commands
    api.display
    api.entries
    api.entries_json
    api.entries_site
    api.auth
    api.invites
    api.entrants
    api.tournaments
    api.schedule
    services.match_state
    services.entries
    services.auth
    services.meet

; Meet names Operations - it reads live match state to build advisories, repair
; proposals and warm restarts - and the solve rail, to hand off suggestion work.
; Both are named seams. It names no other domain.
[importlinter:contract:meet-independence]
name = Meet names only Operations and the solve rail
type = forbidden
allow_indirect_imports = True
source_modules =
    api.schedule
    api.schedule_repair
    api.schedule_warm_restart
    api.schedule_advisories
    api.schedule_proposals
    api.schedule_director
    api.schedule_suggestions
    api._validate
    services.meet
    services.schedule_impact
forbidden_modules =
    api.display
    api.entries
    api.entries_json
    api.entries_site
    api.entries_me
    api.auth
    api.invites
    api.entrants
    api.tournaments
    services.entries
    services.auth
    services.entrants

; Entries names Bracket, because the public site publishes draws, seeds and
; winners (SP-P7).
;
; It also names `services.auth`, which looks like a dependency on Identity and
; is not: the three symbols it uses are `entries_key`, `throttle_check` and
; `throttle_record_entry`, the shared ABUSE THROTTLE. That throttle guards the
; public submit path against a flood, which has nothing to do with who anyone
; is. It lives in the identity service only because that is where the first
; caller needed it. Allowed here, and named in the gate as a fifth module that
; wants extracting into shared infrastructure.
[importlinter:contract:entries-independence]
name = Entries names only Bracket (the public draw projection)
type = forbidden
allow_indirect_imports = True
source_modules =
    api.entries
    api.entries_json
    api.entries_me
    api.entries_public
    services.entries
    services.entry_fees
    services.entry_form
    services.entry_policy
    services.submissions
forbidden_modules =
    api.schedule
    api.schedule_proposals
    api.match_state
    api.commands
    api.display
    api.tournaments
    api.auth
    api.invites
    services.meet
    services.match_state
    services.solve_jobs

; Identity serves both principals, operator and entrant. It names Entries for
; the entrant's own record, plus the unfiled transport modules.
[importlinter:contract:identity-independence]
name = Identity names only Entries
type = forbidden
allow_indirect_imports = True
source_modules =
    api.auth
    api.invites
    api.entrants
    services.auth
    services.members
    services.entrants
forbidden_modules =
    api.schedule
    api.schedule_proposals
    api.brackets
    api.match_state
    api.commands
    api.display
    api.solve_jobs
    services.meet
    services.bracket
    services.match_state
    services.solve_jobs
    services.schedule_impact

; Display is a strict read-only projection. It reads Bracket, Operations and
; Workspaces; nobody reads it. The arrow only ever points outward, and this
; contract holds the other side of that: no domain names Display.
[importlinter:contract:nothing-names-display]
name = Nothing names Display (it is a leaf projection)
type = forbidden
allow_indirect_imports = True
source_modules =
    api.schedule
    api.brackets
    api.match_state
    api.commands
    api.entries
    api.entries_site
    api.tournaments
    api.auth
    api.entrants
    services.meet
    services.bracket
    services.match_state
    services.entries
    services.auth
forbidden_modules =
    api.display

; The health surface is liveness and readiness. /health must answer even when
; everything behind it is broken, so it names no domain at all.
[importlinter:contract:ops-independence]
name = The health surface names no domain
type = forbidden
allow_indirect_imports = True
source_modules =
    api.health
forbidden_modules =
    api.schedule
    api.brackets
    api.match_state
    api.commands
    api.display
    api.entries
    api.entries_json
    api.tournaments
    api.auth
    api.invites
    api.entrants
    services.meet
    services.bracket
    services.match_state
    services.entries
    services.auth
