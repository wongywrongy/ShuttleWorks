# ShuttleWorks scheduler backend — environment template.
#
# Copy to `.env` for local development. The runtime `.env` file is
# gitignored. Production deployments set these via the host's secret
# manager instead of shipping a file.
#
# Every value here is also a code default in ``app/config.py``; this
# file is the canonical list of knobs, not a required configuration.

# ---- Database --------------------------------------------------------
# SQLite for single-laptop / desktop use; Postgres URL for cloud.
# SQLAlchemy auto-selects the driver from the URL scheme.
DATABASE_URL=sqlite:///./local.db
# Local Postgres (docker-compose.dev.yml):
# DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler

# ---- Deployment metadata --------------------------------------------
# `cloud` mode requires a non-sqlite DATABASE_URL, AUTH_MODE=cloud,
# SESSION_COOKIE_SECURE=true, real SMTP, and OPS_TOKEN — the backend
# raises a startup error otherwise.
ENVIRONMENT=local
LOG_LEVEL=info

# Which kind of process this is: `api` (serves HTTP) or `worker` (the
# standalone `python -m worker` container). `worker.py` sets this itself
# before importing config, so the worker host does not have to — set it
# explicitly only for clarity. It exists so the cloud startup validator
# checks what a process actually uses: a worker serves no HTTP, so
# demanding cookie and SMTP settings from it would force fake
# credentials onto a host that never reads them.
PROCESS_ROLE=api

# ---- Network ---------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Accepts either a JSON list or a comma-separated string.
# Example (JSON):   CORS_ORIGINS=["https://app.example.com"]
# Example (CSV):    CORS_ORIGINS=https://a.example.com,https://b.example.com
# Cloud form: CORS_ORIGINS=["https://[YOUR-FRONTEND-DOMAIN]"]
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173

# Peers whose ``CF-Connecting-IP`` header may be believed when deciding
# the real client address (credential throttling and every per-IP entry
# budget key on it). Without it the API sees ONE peer as the source of
# every request on the internet and throttles all users as one, so the
# fifth failed login from anyone locks out everyone.
#
# IT NAMES THE API'S IMMEDIATE PEER, WHICH IS THE ``frontend`` NGINX
# CONTAINER — not cloudflared, which never talks to the API at all:
#
#   browser → cloudflared → frontend:8080 (nginx) → backend:8000
#
# This file said "the cloudflared connector's address" until 2026-08-11.
# It was wrong in the fail-open direction — the trust check simply never
# matches — and it is where the dead ``172.20.0.3`` that shipped in
# .env.selfhost.example came from.
#
# LEAVE BLANK unless you are actually behind a trusted proxy. Blank
# means "trust nothing", the header is never read, and local mode is
# unaffected. NEVER a wildcard, and never a range wider than the network
# the proxy is on: a header trusted from further away is a throttle
# BYPASS, since an attacker can rotate it per request.
# Do NOT also pass uvicorn ``--proxy-headers`` — see app/client_ip.py.
#
# The shipped stacks set this for you, from a network they pin so the
# value can be stable: docker-compose.selfhost.yml defaults it to its
# own subnet (10.201.0.0/24) and docker-compose.release.yml names its
# frontend's fixed address (10.202.0.10). Copy the pattern, not the
# number — a literal from someone else's network cannot match yours, and
# a trust list that cannot match fails open in silence.
TRUSTED_PROXY_IPS=

# ---- Operational endpoints -------------------------------------------
# Shared secret required by /health/ready, /health/deep and
# /health/metrics. NOT by /health — liveness must answer without a
# credential, or a probe cannot tell "unauthorized" from "dead" and your
# orchestrator restarts a healthy container.
#
# Those three report worker identities, live job ids, queue depth and
# the deployed schema revision. An ingress publishes a HOSTNAME, not a
# route list, so on a public deployment "reachable" means "reachable by
# anyone" unless this is set. Cloud mode refuses to start without it.
#
# BLANK = guard off, which is right for local mode (one operator, one
# laptop, no ingress) and for the plain-HTTP compose stacks whose Docker
# HEALTHCHECKs curl /health/deep with no credentials.
#
# Generate:  openssl rand -hex 32
# Prefer OPS_TOKEN_FILE=/run/secrets/ops_token in production — every
# <VAR> here supports a <VAR>_FILE counterpart.
# Send as:   X-ShuttleWorks-Ops-Token: <value>
OPS_TOKEN=

# ---- Filesystem -----------------------------------------------------
# Writable directory the ``/health/deep`` probe checks. Inside the
# Docker image this is bind-mounted from ./data; outside Docker
# any writable path works. ``BACKEND_DATA_DIR`` is honoured as a
# legacy alias for the same setting.
DATA_DIR=./data

# ---- Auth & sessions (SP-CLOUD-2) ------------------------------------
# local = zero-friction solo operator: requests without a session
# resolve to the bootstrap identity (no signup, no email, offline).
# cloud = real accounts required; unauthenticated requests are 401.
AUTH_MODE=local
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=sw_session
# MUST be true in cloud (HTTPS-only cookies); enforced at startup.
SESSION_COOKIE_SECURE=false
# Blank = host-only cookie.
SESSION_COOKIE_DOMAIN=
# Credential-endpoint backoff (per account + per IP).
AUTH_THROTTLE_MAX_FAILURES=5
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_LOCK_SECONDS=60
# NIST 800-63B: length-only password policy.
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
RESET_TOKEN_TTL_MINUTES=60

# ---- Email seam (SP-CLOUD-2) -----------------------------------------
# console = log the full message (local default — invites/resets work
# offline with zero mail config); smtp = generic SMTP for cloud.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ShuttleWorks <no-reply@localhost>
SMTP_USE_TLS=true
# Absolute origin used in emailed links (blank = relative, local mode).
PUBLIC_APP_ORIGIN=
# Email invites expire after this many days (link invites are eternal).
INVITE_TTL_DAYS=14

# ---- Solve jobs & worker runtime (SP-CLOUD-1) ------------------------
# Local mode runs the job worker inside the API process (zero-config).
# Cloud mode sets EMBEDDED_WORKER=false and runs `python -m worker`
# containers against the same DATABASE_URL (docker-compose.cloud.yml).
EMBEDDED_WORKER=true
# One solve owns its CPU allocation — raise only with headroom to spare.
WORKER_CONCURRENCY=1
# Blank = derived as <hostname>-<suffix> at startup.
WORKER_ID=
# Determinism defaults persisted into every job's params at submit:
# fixed seed, single search worker, deterministic-time budget as the
# binding stop. The wall-clock ceiling is an outer safety kill only.
SOLVE_RANDOM_SEED=42
SOLVE_NUM_WORKERS=1
SOLVE_MAX_DETERMINISTIC_TIME=60.0
SOLVE_WALL_CLOCK_CEILING_SECONDS=300.0
# Child-process address-space cap (Linux RLIMIT_AS; logged-off on Windows).
SOLVE_MEMORY_LIMIT_MB=1024
# Lease/retry/retention for the solve_jobs queue.
JOB_LEASE_SECONDS=30.0
JOB_MAX_ATTEMPTS=2
JOB_RETENTION_DAYS=30
JOB_POLL_INTERVAL_SECONDS=1.0
