# ShuttleWorks self-hosted PostgreSQL DR contract (example only).
# Copy into the host secret/config manager; do not commit live credentials.
# Server 2 is a warm standby, not an independent backup and not an automatic
# failover target. Promotion requires the fenced procedure in failover-rejoin.sh.

PG_PRIMARY_HOST=server-1.internal
PG_STANDBY_HOST=server-2.internal
PG_PRIMARY_PORT=5432
PG_STANDBY_PORT=5432
PG_REPLICATION_USER=streaming_replica
PG_REPLICATION_SLOT=shuttleworks_server2
PG_REPLICATION_APP_NAME=shuttleworks-server2

# Keep archive files off both database hosts. The credentials and endpoint are
# injected by the host secret manager, never placed in this file.
PGBACKREST_STANZA=shuttleworks
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_PATH=s3://REPLACE-ME/shuttleworks-postgres
PGBACKREST_REPO1_RETENTION_FULL=4
PGBACKREST_REPO1_RETENTION_DIFF=14
PGBACKREST_REPO1_RETENTION_ARCHIVE=30
PGBACKREST_S3_ENDPOINT=REPLACE-ME
PGBACKREST_S3_BUCKET=REPLACE-ME
PGBACKREST_S3_REGION=REPLACE-ME

# Fencing is an operator-controlled capability. A standby MUST NOT promote
# merely because the primary is unreachable; an unreachable primary may still
# be serving writes. Set this only for a reviewed maintenance window.
FENCING_PROVIDER=external-witness-or-power-control
AUTOMATIC_FAILOVER=false
