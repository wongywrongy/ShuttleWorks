# Environment for docker-compose.worker.yml — a second machine joined
# as pure compute. No API, no Postgres, no migrations, no SMTP.
#
#   cp .env.worker.example .env && chmod 600 .env
#
# Runbook: docs/how-to/add-a-worker.md — it covers creating the
# restricted database role, its exact grants, and how to verify this
# host is actually claiming jobs.
#
# Variables marked REQUIRED are enforced by compose itself (`${VAR:?}`).

# ---- Reaching the primary host's database ---------------------------
# REQUIRED. The primary host's TAILNET address (not a public IP, not a
# hostname that resolves publicly). This host dials out to it.
PRIMARY_TAILNET_HOST=100.64.0.1

# REQUIRED. Password for the restricted `sw_worker` role — NOT the
# owning `scheduler` role.
#
# `sw_worker` holds SELECT/UPDATE/DELETE on solve_jobs and nothing else:
# it cannot read users, auth_sessions, auth_throttle, orgs, org_members,
# tournament_members, invite_links or display_tokens. That is safe
# because the worker genuinely never touches them — the API writes the
# whole solve input into the job row at submit time, and the solve
# runner/child have no database imports at all.
SW_WORKER_PASSWORD=

# ---- Solve tuning ----------------------------------------------------
# Concurrent solves on this host. Raise only with cores to spare, and
# note this buys THROUGHPUT, not latency: a single solve is
# single-threaded by design, because determinism depends on
# num_workers=1.
WORKER_CONCURRENCY=1

# Per-solve child address-space cap (RLIMIT_AS on Linux). RAM, not
# cores, is the real ceiling on concurrency.
SOLVE_MEMORY_LIMIT_MB=2048

# Container memory limit — headroom for WORKER_CONCURRENCY solves plus
# the parent process.
WORKER_MEMORY_LIMIT=8G

# Stable identity in solve_jobs.claimed_by, so /health/metrics can
# attribute a stalled lease to a specific machine. Blank derives
# <hostname>-<suffix>: fine, but less legible in an alert.
WORKER_ID=

# ---- OpenTelemetry (optional; blank means completely off) ------------
# Use the same generic OTLP/HTTP endpoint as the API to preserve traces
# across the database rail. No collector or backend is required by the app.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=2

# ---- Misc ------------------------------------------------------------
LOG_LEVEL=info

# ---- Deliberately absent ---------------------------------------------
# AUTH_MODE, SESSION_COOKIE_*, EMAIL_BACKEND, SMTP_*, CORS_ORIGINS,
# TRUSTED_PROXY_IPS, PUBLIC_APP_ORIGIN, OPS_TOKEN.
#
# A worker answers no requests, sets no cookies, sends no mail, and
# serves no health endpoints. The cloud startup validator knows this
# (PROCESS_ROLE=worker, which worker.py sets itself before importing
# config) and checks only the database configuration. Putting
# placeholder credentials here would be how real ones eventually arrive
# on a machine with no business holding them.
#
# ENVIRONMENT and DATA_DIR are set by the compose file, not here.
