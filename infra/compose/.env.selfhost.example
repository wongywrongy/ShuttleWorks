# Environment for docker-compose.selfhost.yml — the self-hosted stack
# (SPA + API + Postgres 16 + embedded worker + cloudflared).
#
#   cp .env.selfhost.example .env && chmod 600 .env
#
# Runbook: docs/how-to/install-selfhost.md. Full per-variable backend
# reference: backend/.env.example.
#
# Variables marked REQUIRED are enforced by compose itself (`${VAR:?}`)
# — the stack refuses to start without them rather than booting into a
# broken state.
#
# Secrets do NOT live here. The Postgres password, the DATABASE_URL and
# the ops token are injected as FILES from ./secrets/, so they never
# appear in `docker inspect`, a process listing, or shell history. The
# runbook's §2 creates them.

# ---- Ingress ---------------------------------------------------------
# REQUIRED. The public hostname on your Cloudflare tunnel. Also becomes
# CORS_ORIGINS and PUBLIC_APP_ORIGIN, so emailed invite/reset links are
# absolute and the browser is allowed to call the API.
PUBLIC_HOSTNAME=shuttleworks.example.com

# REQUIRED. Token for the NAMED tunnel (Zero Trust → Networks → Tunnels).
# Its ingress rule must point at `frontend:8080` — never at a shared
# reverse proxy, never a wildcard.
CLOUDFLARE_TUNNEL_TOKEN=

# TRUSTED_PROXY_IPS — DELIBERATELY NOT SET HERE. Read this before adding it.
#
# The compose file already defaults it to `10.201.0.0/24`, the subnet it
# pins its own network to, and that is the correct value for a standard
# install. Setting it here can only make things worse, because compose
# interpolates `.env` BEFORE applying that default — so whatever this
# template says WINS over a compose file that is already right.
#
# That is not hypothetical. This template shipped `TRUSTED_PROXY_IPS=
# 172.20.0.3` — an address from a subnet the stack stopped using — and
# since the runbook's day-one step is `cp .env.selfhost.example .env`,
# every install inherited a trust check that could never match. The API
# then ignores CF-Connecting-IP and keys every per-client limit on the
# `frontend` nginx container's address, which is the peer for every
# request on earth: ONE bucket for the whole internet, so the fifth
# failed sign-in from anyone locks out every user. It fails that way
# silently — nothing logs, nothing 500s.
#
# Only if you changed the subnet in `networks:` do you set it here, and
# then it must NAME THE API'S IMMEDIATE PEER — the `frontend` nginx
# container, not cloudflared, which never talks to the API at all:
#
#   TRUSTED_PROXY_IPS=10.201.0.0/24   # must match `networks:` in the compose file
#
# A changed subnet is a THREE-place edit: `networks:`, this, and
# `set_real_ip_from` in frontend/nginx.conf (baked into the image, so it
# needs a rebuild) — that last one is what lets nginx believe
# CF-Connecting-IP from cloudflared for its own rate-limit zones.
#
# NEVER a wildcard or a range wider than the compose network: a header
# trusted from further away is a throttle BYPASS (rotate it per request,
# never get locked out), which is worse than the collapse it fixes. And
# do NOT also pass uvicorn --proxy-headers — the two mechanisms defeat
# each other (see backend/app/client_ip.py). §6 of the runbook has the
# whole story and the day-one smoke check that reveals it.

# ---- Postgres --------------------------------------------------------
# REQUIRED. The tailnet IP to publish Postgres on, for a remote worker.
#
# NEVER 0.0.0.0. Docker writes iptables rules directly and does not
# consult UFW, so a 0.0.0.0 binding is a publicly reachable database no
# matter what `ufw status` says. If no remote worker is in play, delete
# the `ports:` mapping from the compose file entirely — the API reaches
# Postgres over the compose network.
POSTGRES_BIND_ADDR=100.64.0.1

# Where the database lives. Must be a real local filesystem: initdb
# fails on network or synced paths (a OneDrive-backed path errors with
# `could not create directory .../pg_wal`). An explicit bind mount, so
# `docker system prune --volumes` cannot delete it.
POSTGRES_DATA_DIR=./data/postgres

# ---- Email -----------------------------------------------------------
# REQUIRED (SMTP_HOST). Cloud mode refuses to start without real SMTP:
# the console backend writes live invite and password-reset tokens into
# the log stream, which is credential leakage plus silent non-delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ShuttleWorks <no-reply@example.com>

# ---- Solving ---------------------------------------------------------
# Run the worker loop inside the API process. `true` means a single box
# solves without a second machine. Set `false` only if remote workers
# are actually running — otherwise jobs queue forever.
EMBEDDED_WORKER=true

# Concurrent solves. RAM is the ceiling, not cores: two concurrent
# solves on one node degrade both.
WORKER_CONCURRENCY=1

# ---- Entrant tier (the public entry site, /e/*) ----------------------
# Both are set inline in docker-compose.selfhost.yml and neither is
# interpolated from here — they are documented because an operator who
# meets them in `docker inspect` needs to know what they mean and, for the
# second one, that it is not free to differ from the API's.
#
# API_BASE_URL — the compose-network address of the API. Internal only:
# node's fetches are server-side and never leave the host. Unset is a hard
# failure by design (apiBaseUrl() throws), not a silent default.
#   API_BASE_URL=http://api:8000
#
# SESSION_COOKIE_SECURE — MUST equal the API's, which is `true` in this
# stack. Two processes issue cookies on one origin from this single
# variable name: the API's session cookie and node's sw_play_csrf nonce.
# A node container without it issues the nonce WITHOUT `Secure` on an
# HTTPS-only deployment.
#   SESSION_COOKIE_SECURE=true

# ---- Misc ------------------------------------------------------------
LOG_LEVEL=info
