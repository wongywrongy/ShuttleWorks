# Event-node overlay environment (docker-compose.yml + docker-compose.event-node.yml)
#
#   cp infra/compose/.env.example infra/compose/.env
#   cat infra/compose/.env.event-node.example >> infra/compose/.env   # then edit
#   docker compose -f docker-compose.yml -f docker-compose.event-node.yml \
#     --profile event-node up -d --build
#
# Every value below is interpolated by docker-compose.event-node.yml. The
# defaults shown are the ones that file falls back to. Paths are host FILE
# PATHS relative to infra/compose/, never key material.

# ---- Node identity ----------------------------------------------------
# A UUID unique to this node. The API refuses to start under the event_node
# profile without a valid one, because operator factors are scoped to it.
SHUTTLEWORKS_NODE_ID=00000000-0000-0000-0000-000000000001

# ---- Operator authenticator key ring (API only) ------------------------
# Required: the event-node API enforces operator MFA. Generate a SEPARATE ring
# for each node (never copy the cloud ring) with tools/operator-mfa-keyring.py;
# see docs/how-to/security-operations.md. Keep it private and owned by UID 1001.
MFA_KEYRING_FILE=../../secrets/node_operator_mfa_keys.json

# ---- Authority and signing material ------------------------------------
SYNC_AUTHORITY_CAPABILITY_FILE=../../secrets/sync_authority_capability
AUTHORITY_SIGNING_PUBLIC_KEY_FILE=../../secrets/authority_signing_public_key
NODE_SIGNING_KEY_FILE=../../secrets/node_signing_key

# ---- Cloud synchronization (sync agent) --------------------------------
# Blank until the workspace is checked out to this node.
SYNC_TOURNAMENT_ID=
SYNC_CLOUD_URL=
SYNC_POLL_INTERVAL_SECONDS=2

# ---- Telemetry gateway (optional) --------------------------------------
OTEL_GATEWAY_ENDPOINT=https://gateway:4318
OTEL_GATEWAY_TLS_MIN_VERSION=1.2
OTEL_GATEWAY_CA_FILE=../../secrets/otel_gateway_ca.pem
OTEL_GATEWAY_CLIENT_CERT_FILE=../../secrets/otel_gateway_client_cert.pem
OTEL_GATEWAY_CLIENT_KEY_FILE=../../secrets/otel_gateway_client_key.pem
OTEL_EXPORTER_OTLP_TIMEOUT=2
OTEL_RELEASE_CHANNEL=stable
